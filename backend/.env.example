DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development

# Secrets below are dev-only placeholders. Replace before any real deployment.
JWT_GUEST_SECRET="dev-guest-secret-change-me"
JWT_STAFF_SECRET="dev-staff-secret-change-me"
JWT_ADMIN_SECRET="dev-admin-secret-change-me"

# Provider selection — "mock" is the only implementation shipped today.
# Swap to a real value once a real provider client is added under src/providers/*.
WHATSAPP_PROVIDER=mock
SMS_PROVIDER=mock

# Base URL the guest-app is reachable at, used to build QR code / scan links.
GUEST_APP_URL="http://localhost:5173"
# Base URL the platform-admin portal is reachable at (documentation only for now).
ADMIN_PORTAL_URL="http://localhost:5175"
